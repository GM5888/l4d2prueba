vertexlitgeneric
{
$baseTexture "gost/can"
$bumpmap "gost/can_n"
"$color2" "[0.7 0.7 0.7]"

//must have alphatest and nocull ON
$alphatest 1
$nocull 1
$halflambert 1

$phong 1

// try 1: 6 and 70

$phongboost "4.5"
$phongexponent 80

$rimlight 1
$rimlightexponent 4
$rimlightboost .3

$phongtint "[.85 .85 1]"
$phongfresnelranges "[.5 .85 30]"

//$phongdisablehalflambert "1"


$ambientocclusion 1
$AmbientOcclTexture "gost/can_ao" 
//$AmbientOcclColor "[.4 .4 .4]"

$envmap env_cubemap
$envmaptint "[.6 .6 .6]"
$normalmapalphaenvmapmask	"1"

//$envmapfresnel	"1"
//$envmap	"env_cubemap"
//$envmaptint	"[.10 .10 .10]"
//$normalmapalphaenvmapmask	"1"
//$envmapfresnel	"1"

//$lightwarptexture "models\survivors\gambler\gambler_head_wrp"


}
